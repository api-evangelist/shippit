          "name": "Create an order",
          "request": {
            "name": "Create an order",
            "description": {
              "content": "Submits an order to Shippit. Requires a delivery location, user details, and parcel details; Shippit allocates the courier and fills the origin from merchant configuration. MODELED request/response.",
